<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Embedded by build.rs (MSVC): paths over 260 characters open where Windows allows long paths (LongPathsEnabled);
     SQLite opens plain paths, so without this an index under a long repo root cannot create its -journal / -wal. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings xmlns:ws2="http://schemas.microsoft.com/SMI/2016/WindowsSettings">
      <ws2:longPathAware>true</ws2:longPathAware>
    </windowsSettings>
  </application>
</assembly>
