{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/aix-session-start.sh", "timeout": 20 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/aix-prompt-submit.sh", "timeout": 5 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash|PowerShell|Grep|Glob|Read",
        "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/aix-pretool-nudge.sh", "timeout": 5 } ] }
    ]
  }
}
